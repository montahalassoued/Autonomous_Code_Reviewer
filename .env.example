# Copy this file to .env and fill in real values. Never commit .env.

# --- Which repository to review ---
# For a deployed server (Azure Container Apps): a remote Git URL to clone on startup.
TARGET_REPO_URL=https://github.com/owner/repo.git
# For local development against a repo you've already cloned yourself,
# set REPO_PATH instead (TARGET_REPO_URL takes priority if both are set).
# REPO_PATH=C:\path\to\a\local\checkout

# --- LLM provider ---
GROQ_API_KEY=
# Optional: only eval/llm_benchmark.py uses it, to compare Gemini models.
# GOOGLE_API_KEY=
# Groq model for the security, logic and quality agents (optional).
# Unset = the default in review/agents/agent_runner.py.
# REVIEW_AGENT_MODEL=openai/gpt-oss-120b

# --- GitHub integration ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- Observability (optional, planned for Phase 3: no code reads these yet) ---
# Langfuse (open source) - get the keys from your Langfuse project settings.
# LANGFUSE_HOST: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US),
# or the URL of your self-hosted Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Job queue (API enqueues, worker consumes) ---
# memory = in-process, NOT shared between api and worker (tests/single process only).
# azure  = Azure Storage Queue. docker-compose sets this and the
#          Azurite connection string for you, so you rarely need to edit it.
# JOBS_BACKEND=memory
# Local/Azurite auth (compose sets it; do not put real account keys here).
# AZURE_STORAGE_CONNECTION_STRING=
# In Azure: storage account used with managed identity (no keys).
# AZURE_STORAGE_ACCOUNT_NAME=
# REVIEW_QUEUE_NAME=review-jobs
# Seconds a dequeued job stays hidden before it is retried.
# REVIEW_VISIBILITY_TIMEOUT_S=900
# Attempts before a job moves to the "<queue>-poison" queue.
# MAX_ATTEMPTS=3

# --- Postgres (code index + reviews table, which dedupes webhook deliveries) ---
# DEDUPE_BACKEND: memory (default) or postgres (default when JOBS_BACKEND=azure).
# docker-compose sets both for the api and worker containers.
# DEDUPE_BACKEND=postgres
# From your machine (tests, psql) with `docker compose up postgres`:
# DATABASE_URL=postgresql://reviewer:reviewer@localhost:5432/reviewer

ENV=production
