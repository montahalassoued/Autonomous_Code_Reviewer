# Copy this file to .env and fill in real values. Never commit .env.

# --- Which repository to review ---
# For a deployed server (Azure Container Apps): a remote Git URL to clone on startup.
TARGET_REPO_URL=https://github.com/owner/repo.git
# For local development against a repo you've already cloned yourself,
# set REPO_PATH instead (TARGET_REPO_URL takes priority if both are set).
# REPO_PATH=C:\path\to\a\local\checkout

# --- LLM provider ---
GROQ_API_KEY=
# Optional: only eval/llm_benchmark.py uses it, to compare Gemini models.
# GOOGLE_API_KEY=
# Groq model for the security, logic and quality agents (optional).
# Unset = the default in review/agents/agent_runner.py.
# REVIEW_AGENT_MODEL=openai/gpt-oss-120b
# Diff characters sent to the agents (optional, default 12000, about 3k tokens). Whole files that do not fit
# are listed as "not reviewed"; raise it on a paid tier with a higher tokens-per-minute limit.
# REVIEW_MAX_DIFF_CHARS=12000
# One model per agent (optional, each falls back to REVIEW_AGENT_MODEL). The 2026-10-22 benchmark picked
# openai/gpt-oss-120b for all three; gpt-oss-20b does not fit these prompts on the free tier (413 at 8k tokens/min).
# SECURITY_AGENT_MODEL=openai/gpt-oss-120b
# LOGIC_AGENT_MODEL=openai/gpt-oss-120b
# QUALITY_AGENT_MODEL=openai/gpt-oss-120b
# Used by an agent whose model is rate limited (429) for the rest of that review (optional). Unset on purpose:
# no free model tested fits, so a spent quota posts that category as a partial review (docs/DECISIONS.md).
# FALLBACK_AGENT_MODEL=
# LLM call limits (optional, see review/llm_client.py): seconds before a call times out, attempts per call
# (per-minute 429s, 5xx, timeouts; a spent daily quota is never retried), and calls running at once.
# REVIEW_LLM_TIMEOUT_S=60
# REVIEW_LLM_MAX_ATTEMPTS=3
# REVIEW_LLM_MAX_CONCURRENCY=3
# Provider routing (optional, review/llm_client.py): a model may name its provider as "provider:model". A bare model
# or "groq:<model>" goes to Groq; "ollama:<model>" to a local Ollama (default http://localhost:11434/v1); any other
# prefix to the OpenAI-compatible server in <PREFIX>_BASE_URL, e.g. a self-hosted vLLM. The worker refuses to start
# when an agent model routes to a provider that is not configured.
# LOGIC_AGENT_MODEL=ollama:qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_API_KEY=
# Seconds after a review starts when no LLM call starts or waits any more (optional, default 600); keep it
# below REVIEW_VISIBILITY_TIMEOUT_S, or a slow review reappears on the queue and runs twice.
# REVIEW_DEADLINE_S=600
# Tokens (in + out) one agent may spend before it must answer without more tool rounds (optional, default 24000).
# AGENT_TOKEN_BUDGET=24000

# --- GitHub integration ---
# Used by the worker (diff, comments) and by the API (is the PR author a collaborator?).
# Prefer a fine-grained token limited to the reviewed repo: Pull requests read/write, Contents read, Metadata read.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Largest webhook body the API reads, in bytes (optional, default 5 MiB); bigger ones get 413 before any check.
# GITHUB_WEBHOOK_MAX_BODY_BYTES=5242880
# Who may reach the webhook through the docker-compose gateway (infra/gateway/): any (default, needed behind
# ngrok) or github_hooks (only GitHub's webhook IPs: run infra/gateway/refresh_github_hooks_allowlist.py first).
# GATEWAY_WEBHOOK_ALLOWLIST=any
# Repos the webhook accepts, comma-separated. Unset = every event is ignored.
ALLOWED_REPOS=owner/repo

# --- Observability (optional) ---
# Langfuse tracing (review/review_tracing.py): one trace per review, on only when both keys are set; every
# prompt and answer is secret-masked before it is sent, and tests always turn it off. Keys: project settings.
# LANGFUSE_BASE_URL: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US), or your own server.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Job queue (API enqueues, worker consumes) ---
# memory = in-process, NOT shared between api and worker (tests/single process only).
# azure  = Azure Storage Queue. docker-compose sets this and the
#          Azurite connection string for you, so you rarely need to edit it.
# JOBS_BACKEND=memory
# Local/Azurite auth (compose sets it; do not put real account keys here).
# AZURE_STORAGE_CONNECTION_STRING=
# In Azure: storage account used with managed identity (no keys).
# AZURE_STORAGE_ACCOUNT_NAME=
# REVIEW_QUEUE_NAME=review-jobs
# Seconds a dequeued job stays hidden before it is retried.
# REVIEW_VISIBILITY_TIMEOUT_S=900
# Attempts before a job moves to the "<queue>-poison" queue.
# MAX_ATTEMPTS=3

# --- Postgres (code index + reviews table, which dedupes webhook deliveries) ---
# DEDUPE_BACKEND: memory (default) or postgres (default when JOBS_BACKEND=azure).
# docker-compose sets both for the api and worker containers.
# DEDUPE_BACKEND=postgres
# From your machine (tests, psql) with `docker compose up postgres`:
# DATABASE_URL=postgresql://reviewer:reviewer@localhost:5432/reviewer

ENV=production
