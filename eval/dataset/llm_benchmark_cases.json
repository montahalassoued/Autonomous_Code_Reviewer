{
  "_about": "Labelled cases for eval/llm_benchmark.py. Diffs and code are lists of lines (joined with newlines when loaded) so they stay readable. Line numbers in expected_issues are new-file line numbers from the diff hunk.",

  "agents": [
    {
      "id": "sec_sql_injection",
      "agent": "security",
      "diff": [
        "diff --git a/app/users.py b/app/users.py",
        "--- a/app/users.py",
        "+++ b/app/users.py",
        "@@ -10,3 +10,7 @@ import sqlite3",
        " def get_connection():",
        "     return sqlite3.connect(\"app.db\")",
        " ",
        "+def find_user(username):",
        "+    conn = get_connection()",
        "+    query = f\"SELECT * FROM users WHERE name = '{username}'\"",
        "+    return conn.execute(query).fetchall()"
      ],
      "expected_issues": [
        {"file": "app/users.py", "line": 15, "keywords": ["sql injection", "cwe-89", "sql", "parameteriz"]}
      ]
    },
    {
      "id": "sec_command_injection",
      "agent": "security",
      "diff": [
        "diff --git a/tools/archive.py b/tools/archive.py",
        "--- a/tools/archive.py",
        "+++ b/tools/archive.py",
        "@@ -1,2 +1,7 @@",
        " import subprocess",
        " ",
        "+def compress_folder(folder_name):",
        "+    \"\"\"Zip a folder chosen by the user in the web form.\"\"\"",
        "+    cmd = \"tar -czf backup.tar.gz \" + folder_name",
        "+    subprocess.run(cmd, shell=True, check=True)",
        "+    return \"backup.tar.gz\""
      ],
      "expected_issues": [
        {"file": "tools/archive.py", "line": 6, "keywords": ["command injection", "cwe-78", "shell=true", "shell injection", "os command"]}
      ]
    },
    {
      "id": "sec_hardcoded_secret",
      "agent": "security",
      "diff": [
        "diff --git a/app/storage.py b/app/storage.py",
        "--- a/app/storage.py",
        "+++ b/app/storage.py",
        "@@ -1,3 +1,9 @@",
        " import boto3",
        " ",
        "+AWS_ACCESS_KEY_ID = \"AKIAIOSFODNN7EXAMPLE\"",
        "+AWS_SECRET_ACCESS_KEY = \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\"",
        "+",
        "+def get_s3_client():",
        "+    return boto3.client(\"s3\", aws_access_key_id=AWS_ACCESS_KEY_ID,",
        "+                        aws_secret_access_key=AWS_SECRET_ACCESS_KEY)"
