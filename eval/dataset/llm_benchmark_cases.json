      "expected_issues": [
        {"file": "app/storage.py", "line": 4, "keywords": ["hardcoded", "hard-coded", "secret", "credential", "cwe-798", "api key", "access key"]}
      ]
    },
    {
      "id": "sec_clean",
      "agent": "security",
      "diff": [
        "diff --git a/app/users.py b/app/users.py",
        "--- a/app/users.py",
        "+++ b/app/users.py",
        "@@ -10,3 +10,7 @@ import sqlite3",
        " def get_connection():",
        "     return sqlite3.connect(\"app.db\")",
        " ",
        "+def find_user(username: str) -> list[tuple]:",
        "+    conn = get_connection()",
        "+    query = \"SELECT id, name FROM users WHERE name = ?\"",
        "+    return conn.execute(query, (username,)).fetchall()"
      ],
      "expected_issues": []
    },
    {
      "id": "perf_n_plus_one",
      "agent": "performance",
      "diff": [
        "diff --git a/shop/reports.py b/shop/reports.py",
        "--- a/shop/reports.py",
        "+++ b/shop/reports.py",
        "@@ -1,2 +1,9 @@",
        " from shop.db import session, Order, Customer",
        " ",
        "+def orders_with_customer_names():",
        "+    result = []",
        "+    for order in session.query(Order).all():",
        "+        customer = session.query(Customer).filter_by(id=order.customer_id).first()",
        "+        result.append((order.id, customer.name))",
        "+    return result"
      ],
      "expected_issues": [
        {"file": "shop/reports.py", "line": 6, "keywords": ["n+1", "n + 1", "query inside", "query in a loop", "query per", "each iteration", "inside the loop", "join"]}
      ]
    },
    {
      "id": "perf_quadratic_membership",
      "agent": "performance",
      "diff": [
        "diff --git a/analytics/dedupe.py b/analytics/dedupe.py",
        "--- a/analytics/dedupe.py",
        "+++ b/analytics/dedupe.py",
        "@@ -1,1 +1,8 @@",
        " # Helpers for cleaning event streams (often 100k+ events).",
        "+def unique_user_ids(events):",
        "+    seen = []",
        "+    for event in events:",
        "+        if event[\"user_id\"] not in seen:",
        "+            seen.append(event[\"user_id\"])",
        "+    return seen",
        "+"
      ],
      "expected_issues": [
        {"file": "analytics/dedupe.py", "line": 5, "keywords": ["o(n^2)", "o(n²)", "o(n**2)", "quadratic", "linear search", "use a set", "set instead", "set()", "membership"]}
      ]
    },
    {
      "id": "perf_clean",
      "agent": "performance",
      "diff": [
        "diff --git a/analytics/dedupe.py b/analytics/dedupe.py",
        "--- a/analytics/dedupe.py",
        "+++ b/analytics/dedupe.py",
        "@@ -1,1 +1,4 @@",
        " # Helpers for cleaning event streams (often 100k+ events).",
        "+def unique_user_ids(events):",
        "+    return list(dict.fromkeys(event[\"user_id\"] for event in events))",
        "+"
      ],
      "expected_issues": []
    }
  ],

  "decomposer": [
    {
      "id": "decomp_three_concerns",
      "diff": [
        "diff --git a/app/signup.py b/app/signup.py",
        "--- a/app/signup.py",
        "+++ b/app/signup.py",
        "@@ -1,4 +1,14 @@",
        " from app.auth import hash_password",
        " from app.db import db",
        " from app.mailer import send_email",
        " ",
        "+def register(email, password):",
        "+    hashed = hash_password(password)",
        "+    user_id = db.execute(",
        "+        \"INSERT INTO users (email, password_hash) VALUES (?, ?)\",",
        "+        (email, hashed),",
        "+    ).lastrowid",
        "+    send_email(to=email, subject=\"Welcome!\", body=\"Thanks for signing up.\")",
        "+    return user_id"
      ],
      "expected_concerns": [
        ["password", "hash", "auth", "credential"],
        ["database", "db", "insert", "sql", "user record", "persist", "store"],
        ["email", "mail", "welcome", "notification"]
      ]
    },
