  "chunker": [
    {
      "id": "chunk_method",
      "file_path": "payments/gateway.py",
      "calls": ["_post", "_sign_request"],
      "code": [
        "def charge_card(self, card, amount, currency=\"USD\"):",
        "    payload = {\"card\": card.token, \"amount\": amount, \"currency\": currency}",
        "    signed = _sign_request(payload)",
        "    return _post(\"/charges\", signed)"
      ],
      "keywords": ["charge", "card", "payment"]
    },
    {
      "id": "chunk_function",
      "file_path": "rag/hybrid_search.py",
      "calls": [],
      "code": [
        "def _reciprocal_rank_fusion(rankings, k=60):",
        "    scores = {}",
        "    for ranking in rankings:",
        "        for rank, doc_id in enumerate(ranking):",
        "            scores[doc_id] = scores.get(doc_id, 0.0) + 1.0 / (k + rank + 1)",
        "    return sorted(scores, key=scores.get, reverse=True)"
      ],
      "keywords": ["rank", "fusion", "combin", "merg"]
    },
    {
      "id": "chunk_validator",
